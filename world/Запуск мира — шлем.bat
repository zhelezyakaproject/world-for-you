@echo off
chcp 65001 >nul
title Симуляция #1 — сервер (не закрывать, пока идёт встреча)
cd /d "%~dp0"

rem остановить прошлый сервер, если он остался
curl -s -X POST http://127.0.0.1:8010/quit >nul 2>nul

echo.
echo  Симуляция #1 запускается. Окно Chrome откроется само через несколько секунд.
echo  В Chrome нажми «Войти в мир». Это окно не закрывай до конца встречи.
echo.
set OPEN=1
node server.mjs
echo.
echo  Сервер остановлен. Нажми любую клавишу, чтобы закрыть окно.
pause >nul
